# Dependencies and build output
node_modules/
dist/
build/

# The Xcode project is generated from macos-app/project.yml by XcodeGen,
# so it is never committed. Edit project.yml instead.
macos-app/*.xcodeproj/
DerivedData/
*.xcuserstate
xcuserdata/

