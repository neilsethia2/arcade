*.dmg

# Signing material must never be committed
*.p12
*.cer
*.mobileprovision
*.provisionprofile
*.keychain
*.keychain-db
AuthKey_*.p8
.env
.env.*

# macOS and editors
.DS_Store
.vscode/
.idea/
