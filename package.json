{
  "name": "safari-arcade",
  "private": true,
  "version": "0.2.0",
  "description": "A personal gaming hub for Safari on macOS, packaged as a Safari Web Extension.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
