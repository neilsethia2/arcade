{
  "manifest_version": 3,
  "name": "Safari Arcade",
  "description": "Your personal gaming corner. Six games, one click away in the Safari toolbar.",
  "version": "0.0.0",
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png",
    "256": "icons/icon-256.png",
    "512": "icons/icon-512.png"
  },
  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },
  "action": {
    "default_title": "Open Safari Arcade",
    "default_icon": {
      "16": "icons/toolbar-16.png",
      "19": "icons/toolbar-19.png",
      "32": "icons/toolbar-32.png",
      "38": "icons/toolbar-38.png",
      "48": "icons/toolbar-48.png",
      "72": "icons/toolbar-72.png"
    }
  },
  "permissions": ["storage"]
}
